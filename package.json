{
  "name": "mcpify",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "portal": "pnpm --filter @mcpify/portals dev",
    "mcp": "pnpm --filter @mcpify/mcp-server dev",
    "demo": "pnpm build:web && pnpm --parallel --filter @mcpify/api --filter @mcpify/portals --filter @mcpify/mcp-server start",
    "api": "pnpm --filter @mcpify/api dev",
    "build:web": "pnpm --filter @mcpify/agent-ready build && pnpm --filter @mcpify/extension build",
    "tunnel": "cloudflared tunnel --url http://localhost:4100 --http-host-header localhost:4100",
    "voice:up": "pnpm --filter @mcpify/voice voice:up",
    "demo:all": "pnpm build:web && pnpm --parallel --filter @mcpify/api --filter @mcpify/portals --filter @mcpify/mcp-server --filter @mcpify/voice start & pnpm --filter @mcpify/dashboard dev",
    "demo:reset": "pnpm --filter @mcpify/api demo:reset"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cloudflared": "0.7.3",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
