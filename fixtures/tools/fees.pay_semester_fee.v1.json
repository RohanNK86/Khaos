  "name": "pay_semester_fee",
  "title": "Pay semester fee",
  "description": "Pay the semester fee on the University Fee Portal (DEMO) through its simulated payment gateway (no money moves). Payment is never automated without the human: it PAUSES to ask the user for their portal password and for the card number, expiry and CVV (never stored), PAUSES for the user's confirmation before pressing Pay (irreversible), and then asks for the OTP sent to their registered mobile. Returns receipt_number and amount_paid.",
  "version": 1,
  "status": "approved",
  "inputSchema": {
    "type": "object",
    "properties": {
      "student_id": {
        "type": "string",
        "pattern": "^[A-Z]{4}\\d{7}$",
        "title": "Student ID",
        "description": "As printed on the student ID card, e.g. DEMO2026001"
      },
      "name_on_card": {
        "type": "string",
        "title": "Name on card",
        "description": "As printed on the card"
      }
    },
    "required": [
      "student_id",
      "name_on_card"
    ],
    "additionalProperties": false
  },
  "outputs": [
    "receipt_number",
    "amount_paid"
  ],
