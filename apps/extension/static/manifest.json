{
  "manifest_version": 3,
  "name": "MCPify (user mode)",
  "short_name": "MCPify",
  "version": "0.1.0",
  "description": "Run verified MCPify tools on the page you are on. Dry-run by default on every site outside the demo list.",
  "minimum_chrome_version": "120",
  "action": { "default_title": "Open MCPify" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "scripting", "activeTab", "declarativeNetRequest", "declarativeNetRequestFeedback"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "web_accessible_resources": [],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
