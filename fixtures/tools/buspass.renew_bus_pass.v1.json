{
  "id": "5c1a0b6e-0000-4000-8000-000000000005",
  "siteId": "site-buspass",
  "name": "renew_bus_pass",
  "title": "Renew student bus pass",
  "description": "Renew a student bus pass on the Student Bus Pass Portal (DEMO): finds the existing pass, confirms the personal details, uploads the photo, picks the route and validity dates (at most 6 months). It PAUSES for the user's confirmation before sending the OTP and again before the final submission, and asks the user for the OTP sent to their registered mobile. Returns pass_number.",
  "version": 1,
  "status": "approved",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pass_number": {
        "type": "string",
        "pattern": "^BPS-\\d{4}-\\d{6}$",
        "title": "Existing pass number"
      },
      "date_of_birth": {
        "type": "string",
        "format": "date",
        "title": "Date of birth",
        "description": "YYYY-MM-DD"
      },
      "confirm_details": {
        "type": "boolean",
        "const": true,
        "title": "Confirmation that the personal details shown are correct"
      },
      "photo": {
        "type": "string",
        "default": "sample-student-photo.png",
        "title": "Photo file",
        "description": "JPG/PNG, max 500 KB; file name in the MCPify file store"
      },
      "route": {
        "type": "string",
        "enum": [
          "Route 7: Old Bus Stand - Demo University",
          "Route 12: Railway Station - Demo Government College",
          "Route 21: Lake Circle - Demo Polytechnic"
        ],
        "title": "Route"
      },
      "from_date": {
        "type": "string",
        "format": "date",
        "title": "Valid from",
        "description": "YYYY-MM-DD"
      },
      "to_date": {
        "type": "string",
        "format": "date",
        "title": "Valid to",
        "description": "YYYY-MM-DD; after valid from, at most 6 months later"
      }
    },
    "required": [
      "pass_number",
      "date_of_birth",
      "confirm_details",
      "route",
      "from_date",
      "to_date"
    ],
    "additionalProperties": false
  },
  "outputs": [
    "pass_number"
  ],
  "startUrl": "http://localhost:5103/renew/1",
