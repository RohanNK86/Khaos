            },
            {
              "kind": "text",
              "value": "Login"
            }
          ]
        }
      ],
      "post": [
        {
          "kind": "urlMatches",
          "pattern": "/dues$"
        }
      ],
      "risk": "auth",
      "repair": "human",
      "timeoutMs": 15000
    },
    {
      "id": "read_amount_due",
      "intent": "Read the amount due for this semester",
      "action": {
        "type": "extract"
      },
      "locators": [
        {
          "kind": "id",
          "value": "lblAmountDue"
        },
        {
          "kind": "near",
          "anchorText": "Amount due",
          "tag": "span"
        }
      ],
      "pre": [],
      "post": [
        {
          "kind": "extract",
          "locators": [
            {
              "kind": "id",
              "value": "lblAmountDue"
            },
            {
              "kind": "near",
              "anchorText": "Amount due",
              "tag": "span"
            }
          ],
          "as": "amount_due",
          "pattern": "Rs\\. [\\d,]+\\.\\d{2}"
        }
      ],
      "risk": "read",
      "repair": "auto"
    },
    {
      "id": "read_due_date",
      "intent": "Read the fee due date",
      "action": {
