{
  "id": "5c1a0b6e-0000-4000-8000-000000000001",
  "siteId": "site-scholarship",
  "name": "apply_scholarship",
  "title": "Apply for State Scholarship",
  "description": "Apply for the Post-Matric Scholarship 2026-27 on the State Scholarship Portal (DEMO). Fills all three pages of the form. It PAUSES for the user's confirmation before sending the OTP and again before the final submission, and asks the user for the OTP (sent to their mobile) and the CAPTCHA shown on the page. Returns application_id.",
  "version": 1,
  "status": "approved",
  "inputSchema": {
    "type": "object",
    "properties": {
      "applicant_name": {
        "type": "string",
        "title": "Applicant name"
      },
      "date_of_birth": {
        "type": "string",
        "format": "date",
        "title": "Date of birth",
        "description": "YYYY-MM-DD"
      },
      "gender": {
        "type": "string",
        "enum": [
          "Male",
          "Female",
          "Other"
        ],
        "title": "Gender"
      },
      "mobile": {
        "type": "string",
        "pattern": "^[6-9]\\d{9}$",
        "title": "Mobile number",
        "description": "10 digits; the OTP is sent here"
      },
      "email": {
        "type": "string",
        "format": "email",
        "title": "Email"
      },
      "course": {
        "type": "string",
        "enum": [
          "B.Sc",
          "B.Com",
          "B.A",
          "B.E",
          "Diploma"
        ],
        "title": "Course"
      },
      "year_of_study": {
        "type": "string",
        "enum": [
          "1st Year",
          "2nd Year",
          "3rd Year",
          "4th Year"
        ],
        "title": "Year of study"
      },
      "institution_name": {
        "type": "string",
        "title": "Institution name"
      },
      "annual_income": {
        "type": "integer",
        "minimum": 0,
        "title": "Annual family income (Rs)"
      },
      "category": {
        "type": "string",
        "enum": [
          "General",
          "OBC",
          "SC",
          "ST"
        ],
        "title": "Category"
      },
      "declaration": {
        "type": "boolean",
        "const": true,
        "title": "Declaration that the information is true"
      },
      "income_certificate": {
        "type": "string",
        "default": "sample-income-certificate.pdf",
        "title": "Income certificate file",
        "description": "File name in the MCPify file store"
      }
    },
    "required": [
      "applicant_name",
      "date_of_birth",
      "gender",
      "mobile",
      "email",
      "course",
      "year_of_study",
      "institution_name",
      "annual_income",
      "category",
      "declaration"
    ],
    "additionalProperties": false
  },
  "outputs": [
    "application_id"
  ],
  "startUrl": "http://localhost:5101/apply/1",
  "steps": [
