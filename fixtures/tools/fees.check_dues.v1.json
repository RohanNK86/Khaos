{
  "id": "5c1a0b6e-0000-4000-8000-000000000003",
  "siteId": "site-fees",
  "name": "check_dues",
  "title": "Check semester fee dues",
  "description": "Look up the semester fee dues on the University Fee Portal (DEMO). Read-only: nothing is paid or submitted. It PAUSES once to ask the user for their portal password (used to log in, never stored). Returns amount_due, due_date and fee_status.",
  "version": 1,
  "status": "approved",
  "inputSchema": {
    "type": "object",
    "properties": {
      "student_id": {
        "type": "string",
        "pattern": "^[A-Z]{4}\\d{7}$",
        "title": "Student ID",
        "description": "As printed on the student ID card, e.g. DEMO2026001"
      }
    },
    "required": [
      "student_id"
    ],
    "additionalProperties": false
  },
  "outputs": [
    "amount_due",
    "due_date",
    "fee_status"
  ],
  "startUrl": "http://localhost:5102/login",
  "steps": [
