          "kind": "textPresent",
          "text": "Student Login"
        }
      ],
      "risk": "read",
      "repair": "auto"
    },
    {
      "id": "enter_student_id",
      "intent": "Fill the student ID",
      "action": {
        "type": "fill",
        "param": "student_id"
      },
      "locators": [
