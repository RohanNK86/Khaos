              "value": "student_id"
            },
            {
              "kind": "id",
              "value": "txtStudentId"
            },
            {
              "kind": "name",
              "value": "student_id"
            },
            {
              "kind": "label",
              "value": "Student ID"
            }
          ]
        }
      ],
      "post": [
        {
          "kind": "valueEquals",
          "locators": [
            {
              "kind": "testid",
              "value": "student_id"
            },
            {
              "kind": "id",
              "value": "txtStudentId"
            },
            {
              "kind": "name",
              "value": "student_id"
            },
            {
              "kind": "label",
              "value": "Student ID"
            }
          ],
          "param": "student_id"
        },
        {
          "kind": "noErrorNear",
          "locators": [
            {
              "kind": "testid",
              "value": "student_id"
            },
            {
              "kind": "id",
              "value": "txtStudentId"
            },
            {
              "kind": "name",
              "value": "student_id"
            },
            {
              "kind": "label",
              "value": "Student ID"
            }
          ]
        }
      ],
      "risk": "fill",
      "repair": "auto"
    },
    {
      "id": "enter_password",
      "intent": "Enter the student's portal password",
      "action": {
        "type": "userInput",
        "param": "password",
        "prompt": "Please type your fee portal password. I will not store it."
      },
      "locators": [
